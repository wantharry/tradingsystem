# ─────────────────────────────────────────────────────────
#  STOCK ANALYSIS TRADING SYSTEM — ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The system works out of the box with NO keys (uses yfinance).
# API keys unlock richer data sources.

# ── Application ─────────────────────────────────────────
APP_NAME="Stock Analysis Trading System"
DEBUG=false

# ── Database ────────────────────────────────────────────
# SQLite by default — no setup required.
# For PostgreSQL: postgresql+asyncpg://user:password@host/db
DATABASE_URL=sqlite:///./data/trading.db

# ── Free Data API Keys (optional but recommended) ───────
# Get a free FRED key at https://fred.stlouisfed.org/docs/api/api_key.html
# Provides: Interest rates, CPI, GDP, unemployment, VIX history
FRED_API_KEY=

# Get a free Alpha Vantage key at https://www.alphavantage.co/support/#api-key
# Provides: Supplemental price data, earnings dates, earnings estimates
ALPHA_VANTAGE_API_KEY=

# ── Risk Parameters ─────────────────────────────────────
# Percentage of portfolio to risk per trade (1 = 1%)
DEFAULT_RISK_PER_TRADE_PCT=1.0

# Stop all trading if daily portfolio loss exceeds this percentage
MAX_DAILY_LOSS_PCT=2.0

# Maximum open positions at any one time
MAX_CONCURRENT_POSITIONS=5

# ── Default Watchlist ────────────────────────────────────
# Comma-separated list of symbols to track.
# Uses Yahoo Finance ticker format.
# Equities: AAPL, MSFT | Futures: ES=F, NQ=F | ETFs: SPY, QQQ
DEFAULT_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,SPY,QQQ,IWM,GLD,TLT,ES=F,NQ=F,CL=F,GC=F

# ── Backtest Settings ────────────────────────────────────
# How many years of history to use for backtesting
BACKTEST_PERIOD_YEARS=3

# Walk-forward: what fraction of data is used for training (rest is test)
WALK_FORWARD_TRAIN_RATIO=0.7

# Minimum number of trades for a strategy result to be considered valid
MIN_TRADES_FOR_VALIDITY=30

# ── CORS (for development) ───────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
